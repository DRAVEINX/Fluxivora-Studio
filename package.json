{
  "name": "fluxivora-studio",
  "version": "0.5.0-beta.7",
  "description": "Free, local-first creative studio for photo editing, vector design, page layout and multi-track video editing on Windows.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "author": "DRAVEINX",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --dir",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/app.js && node --check src/core.js && node --check src/video-studio.js && node --check src/motion-pro.js && node --check electron/video-render.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.fluxivora.desktop",
    "productName": "Fluxivora Studio",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "assets/fluxivora.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Fluxivora-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fluxivora Studio"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
